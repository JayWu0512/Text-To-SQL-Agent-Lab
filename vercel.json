{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {"api/index.py": {"maxDuration": 30, "excludeFiles": "{text_to_sql_server.py,tests/**}"}},
  "rewrites": [
    {"source": "/api/:route*", "destination": "/api?route=:route*"},
    {"source": "/text-to-sql", "destination": "/index.html"}
  ]
}
