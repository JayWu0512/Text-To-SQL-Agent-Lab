# Local-only credentials. Copy this file to .env and fill in the values.
# Required: connect to your Chroma Cloud database.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=text-to-sql-agent-lab

# Required for local OpenAI agent runs and for Chroma Cloud OpenAI embeddings.
OPENAI_API_KEY=

# Optional alternative for local Duke AI Gateway agent runs.
DUKE_API_KEY=

# Required only to index schema_docs from Supabase.
SUPABASE_CONNECTION_URL=postgresql://USER:[YOUR-PASSWORD]@HOST:5432/postgres
SUPABASE_DATABASE_PASSWORD=

# Used only by the deployed Vercel "Index Chroma Cloud" button.
CHROMA_SEED_TOKEN=
